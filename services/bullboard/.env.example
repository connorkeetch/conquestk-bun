# Bull Board Configuration

# Server
PORT=3000

# Redis Connection (REQUIRED)
# Use the same Redis instance as your main backend
REDIS_URL=redis://localhost:6379

# Bull Queue Prefix (must match backend)
# Default is 'bull' - check your backend's BULL_PREFIX env var
BULL_PREFIX=bull

# Authentication (REQUIRED for production)
BB_USERNAME=admin
BB_PASSWORD=change-me-to-a-strong-password

# Cookie Secret (for session management)
COOKIE_SECRET=change-me-to-a-random-32-char-string

# Logging
LOG_LEVEL=info
