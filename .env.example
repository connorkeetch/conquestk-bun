# Backend Environment Variables Example
# Copy this file to backend/.env and update with your values

# Server Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration
# Use 'sqlite' for development (easy setup) or 'postgresql' for production
DB_TYPE=sqlite
SQLITE_DB_PATH=./risk_game.db

# PostgreSQL Configuration (uncomment when using PostgreSQL)
# DB_TYPE=postgresql  
# DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Email Configuration (optional)
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# SMTP Settings (if using SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# SendGrid (if using SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@conquestk.com
SENDGRID_FROM_NAME=ConquestK

# Web Push Notifications - Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:admin@yourdomain.com

# Logging
LOG_LEVEL=info

# Frontend Environment Variables Example
# Copy to frontend/.env and frontend/.env.production

# Development
VITE_API_URL=http://localhost:5001/api
VITE_SOCKET_URL=http://localhost:5001
VITE_VAPID_PUBLIC_KEY=same-as-backend-vapid-public-key

# Production
# VITE_API_URL=https://yourdomain.com/api
# VITE_SOCKET_URL=https://yourdomain.com