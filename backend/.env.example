# Server Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Host & Canonical Routing (production/staging recommended)
# When set in production, all requests will be redirected to this host (308) except Socket.IO handshakes.
CANONICAL_HOST=conquestk.com

# Database Configuration (REQUIRED)
# For PostgreSQL, use format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/risk_game

# Authentication (REQUIRED - use strong secrets in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-chars
JWT_EXPIRES_IN=7d
SESSION_SECRET=your-super-secret-session-key-also-change-this-minimum-32-chars

# Database Connection Pool (optional but recommended)
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=2000
DB_STATEMENT_TIMEOUT=30000
DB_QUERY_TIMEOUT=30000

# File Upload
MAX_FILE_SIZE=5242880

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Redis Configuration (HIGHLY RECOMMENDED for production)
# Used for:
#   - Rate limiting (persistent across server restarts)
#   - Session storage (enables horizontal scaling)
#   - Socket.io adapter (multi-server support)
#   - Caching (improved performance)
# Format: redis://user:password@host:port/db
# Railway Redis format: redis://default:password@host.railway.internal:6379
REDIS_URL=redis://localhost:6379

# Redis Cluster (optional; prefer single REDIS_URL unless running a cluster)
# REDIS_CLUSTER_NODES=host1:6379,host2:6379,host3:6379
# REDIS_PASSWORD=

# Logging
LOG_LEVEL=info
STARTUP_VERBOSE=false

# Sentry (optional)
# When set, errors and traces are sent to Sentry.
# SENTRY_DSN=

# Odds & AI evaluation engines
# Engine options: ts | wasm | shadow
#  - ts:    pure TypeScript implementation (default)
#  - wasm:  Rust→WASM implementation, falls back to TS if unavailable
#  - shadow:compute both, log divergences, return TS (safe rollout)
ODDS_ENGINE=ts
AI_EVAL_ENGINE=ts

# Odds shadow verification (optional; enables nightly verification via MaintenanceWorker)
# ODDS_SHADOW_SCHEDULED=false
# ODDS_SHADOW_CRON=30 3 * * *
# ODDS_SHADOW_TRIALS=100000
# ODDS_SHADOW_ATT_MIN=5
# ODDS_SHADOW_ATT_MAX=40
# ODDS_SHADOW_DEF_MIN=5
# ODDS_SHADOW_DEF_MAX=35
# ODDS_SHADOW_SEED_HI=0xA1B2C3D4
# ODDS_SHADOW_SEED_LO=0x0F1E2D3C
# AI streaming and human-friendly delays (optional)
# AI_STREAM_ACTIONS=true
# AI_READABLE_DELAY_MS=0

# Email Configuration (using Resend)
EMAIL_ENABLED=true
EMAIL_FROM=noreply@updates.conquestk.com  # Updates subdomain verified in Resend
EMAIL_FROM_NAME=ConquestK Game
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# Resend Configuration
RESEND_API_KEY=your-resend-api-key-here

# Alternative: SMTP Configuration (if not using Resend)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-specific-password
# Note: current code path sends via Resend; SMTP_* is reserved for future use.

# Web Push (optional; enables browser push notifications)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=mailto:admin@conquestk.com

# Notification Dispatching
ENABLE_EXTERNAL_NOTIFICATIONS=false
NOTIFICATION_CHANNELS=webpush,slack

# Slack Webhook Notifications
SLACK_NOTIFICATIONS_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX
SLACK_WEBHOOK_URLS=
SLACK_DEFAULT_CHANNEL=#operations
SLACK_ADDITIONAL_CHANNELS=#community,#devops
SLACK_USERNAME=ConquestK Alerts
SLACK_ICON_EMOJI=:crossed_swords:

# Slack App (Phase 2 prep — keep real values in .env.local only)
SLACK_APP_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_VERIFICATION_TOKEN=
# Populate once the app is installed and a bot token is issued:
# SLACK_BOT_TOKEN=xoxb-...

# Discord webhooks (Phase 1 foundations)
DISCORD_NOTIFICATIONS_ENABLED=false
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456789012345678/XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DISCORD_WEBHOOK_URLS=
DISCORD_USERNAME=ConquestK Alerts
DISCORD_AVATAR_URL=
DISCORD_THREAD_ID=

# Public Asset URLs (recommended when using CDN or R2/S3)
# Used for generating absolute URLs in emails, CSP, and asset resolution.
PUBLIC_ASSET_BASE_URL=https://assets.conquestk.com
# The frontend also uses this base to resolve map/audio assets; backend seeds CDN health from it.
VITE_ASSET_BASE_URL=https://assets.conquestk.com

# Asset storage (Cloudflare R2 / S3-compatible). If omitted, uploads fall back to local /uploads.
# Provide all four to enable remote uploads.
# ASSET_BUCKET=conquestk
# ASSET_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# ASSET_ACCESS_KEY_ID=
# ASSET_SECRET_ACCESS_KEY=
# ASSET_REGION=auto
# Optional: override local directory for map staging uploads (dev/testing)
# MAP_UPLOADS_DIR=./map-uploads

# CDN configuration (optional)
# CDN_PRIMARY_URL=https://assets.conquestk.com
# CDN_API_KEY=
# CDN_REGIONAL_URLS=us=https://us.cdn.example.com,eu=https://eu.cdn.example.com
# CDN_GAME_ASSETS_URL=
# CDN_UPLOAD_ENDPOINT=

# Maintenance & data retention (optional overrides — sensible defaults are built-in)
# How long to retain in-app notifications (in days). Default: 60. Unread kept by default.
NOTIFICATION_RETENTION_DAYS=60
# If true, also prune unread notifications older than retention. Default: false
PRUNE_NOTIFICATIONS_INCLUDE_UNREAD=false
# Interval for maintenance prune worker (ms). Default: daily (86_400_000).
# Uncomment to override cadence:
# MAINTENANCE_PRUNE_INTERVAL_MS=86400000
# Optional: archive batch size for completed game moves (default 25)
# GAME_MOVE_ARCHIVE_BATCH_SIZE=25

# Queues & BullMQ (optional)
# BULL_PREFIX=bull
# QUEUE_READY_TIMEOUT_MS=15000
# QUEUE_HEALTH_STRICT=true

# Worker scaling (optional)
# ENABLE_AUTO_SCALING=true
# MIN_WORKERS=2
# MAX_WORKERS=4

# Match Service integration (optional)
# USE_MATCHSVC=false
# MATCHSVC_URL=http://localhost:8085
# MATCHSVC_HMAC_SECRET=

# Memory diagnostics (optional)
# MEMORY_MONITOR_ENABLED=true
# MEMORY_MONITOR_SNAPSHOT_DIR=./health-reports/memory
# MEMORY_MONITOR_INTERVAL_MS=15000
# MEMORY_MONITOR_GROWTH_THRESHOLD_MB=120
# MEMORY_MONITOR_MIN_SAMPLES=8
# MEMORY_MONITOR_ALERT_COOLDOWN_MS=600000
# MEMORY_MONITOR_HISTORY_SIZE=24

# Startup toggles (optional)
# SYNC_FEATURE_FLAGS_ON_START=false
# RUN_DEPLOY_ACCOUNT_ENFORCEMENT_ON_START=false
# SKIP_DEPLOY_ACCOUNT_ENFORCEMENT=false
# ENFORCE_DEPLOY_ACCOUNT_CHECK=false
# DEPLOY_ENV=
# APP_ENV=
# SKIP_DB_CONNECTION_TEST=false
# TEST_BASE_URL=http://localhost:5001

# Railway environment variables are injected by the platform (no need to set):
# RAILWAY_ENVIRONMENT, RAILWAY_ENVIRONMENT_NAME, RAILWAY_PROJECT_ID, RAILWAY_SERVICE_ID
