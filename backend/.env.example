# Server Configuration
# Dev:    PORT=5001, NODE_ENV=development, FRONTEND_URL=http://localhost:5173
# Prod:   NODE_ENV=production, FRONTEND_URL=https://conquestk.com
#         PORT is typically injected by the platform (Railway). You usually do not set PORT in prod.
PORT=5001 # dev; Railway injects PORT in prod
NODE_ENV=development # dev (use 'production' or 'staging' in deploys)
FRONTEND_URL=http://localhost:5173 # dev; prod=https://conquestk.com

# Host & Canonical Routing (production/staging recommended)
# In production, Express redirects non-canonical hosts (308) to this apex host.
# Socket.IO handshakes are exempt to avoid breaking upgrades.
CANONICAL_HOST=conquestk.com # prod/staging default when unset
# Default when unset (prod/staging): conquestk.com

# Database Configuration (REQUIRED)
# For PostgreSQL, use format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/risk_game # required

# Authentication (REQUIRED - use strong secrets in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-chars # required; 32+ chars
JWT_EXPIRES_IN=7d # default
SESSION_SECRET=your-super-secret-session-key-also-change-this-minimum-32-chars # required in prod; generated in dev if missing

# Database Connection Pool (optional but recommended)
DB_POOL_MAX=20 # default: 25 (prod) / 15 (dev)
# DB_POOL_MIN=5 # default: 5 (prod) / 2 (dev)
DB_POOL_IDLE_TIMEOUT=30000 # default: 60000 (prod) / 30000 (dev)
DB_POOL_CONNECTION_TIMEOUT=2000 # default: 15000 (Railway) / 5000 (elsewhere)
DB_STATEMENT_TIMEOUT=30000 # default
DB_QUERY_TIMEOUT=30000 # default

# File Upload
MAX_FILE_SIZE=5242880 # bytes (5MB)

# CORS Configuration
# Production/staging: allowed origins are pinned to https://conquestk.com and https://www.conquestk.com.
# Development: http://localhost:5173 and http://localhost:3000 are allowed by default; FRONTEND_URL is also allowed if set.
CORS_ORIGIN=http://localhost:5173 # dev only; prod/staging are pinned

# Redis Configuration (HIGHLY RECOMMENDED for production)
# Used for:
#   - Rate limiting (persistent across server restarts)
#   - Session storage (enables horizontal scaling)
#   - Socket.io adapter (multi-server support)
#   - Caching (improved performance)
# Format: redis://user:password@host:port/db
# Railway Redis format: redis://default:password@host.railway.internal:6379
REDIS_URL=redis://localhost:6379 # required in prod for sessions/queues/sockets

# Redis Cluster (optional; prefer single REDIS_URL unless running a cluster)
# REDIS_CLUSTER_NODES=host1:6379,host2:6379,host3:6379
# REDIS_PASSWORD=

# Logging & Diagnostics
# LOG_LEVEL controls Winston verbosity. Allowed: error, warn, info, http, verbose, debug, silly
#   - Production: typically 'info' (or 'warn' to reduce log volume)
#   - Development: 'debug' or 'silly' for deep traces
LOG_LEVEL=info # prod: info/warn; dev: debug/silly
# STARTUP_VERBOSE prints extended startup diagnostics when true, or when LOG_LEVEL=debug/silly
#   - Recommended false in production; enable temporarily for deploy debugging
STARTUP_VERBOSE=false

# Sentry (optional)
# When set, unhandled errors and sampled traces are sent to Sentry.
# SENTRY_DSN=

# Odds & AI evaluation engines
# Engine options: ts | wasm | shadow
#  - ts:    pure TypeScript implementation (default)
#  - wasm:  Rust→WASM implementation, falls back to TS if unavailable
#  - shadow:compute both, log divergences, return TS (safe rollout)
ODDS_ENGINE=ts # ts|wasm|shadow
AI_EVAL_ENGINE=ts # ts|wasm|shadow

# Odds shadow verification (optional; enables nightly verification via MaintenanceWorker)
# ODDS_SHADOW_SCHEDULED=false
# ODDS_SHADOW_CRON=30 3 * * *
# ODDS_SHADOW_TRIALS=100000
# ODDS_SHADOW_ATT_MIN=5
# ODDS_SHADOW_ATT_MAX=40
# ODDS_SHADOW_DEF_MIN=5
# ODDS_SHADOW_DEF_MAX=35
# ODDS_SHADOW_SEED_HI=0xA1B2C3D4
# ODDS_SHADOW_SEED_LO=0x0F1E2D3C
# AI streaming and human-friendly delays (optional)
# AI_STREAM_ACTIONS=true
# AI_READABLE_DELAY_MS=0

# Lockstep Configuration (Phase 1 - see docs/planning/lockstep-architecture-refactor.md)
# LOCKSTEP_ONLY: when true, only emit snapshots for init/resync/fog (not after every action)
# Default: false (preserves current hybrid behavior for safe rollout)
LOCKSTEP_ONLY=false
# LOCKSTEP_MAX_FRAMES: max frames retained before pruning (default: 2000)
LOCKSTEP_MAX_FRAMES=2000
# LOCKSTEP_CHECKSUMS: enable checksum validation for desync detection (default: true)
LOCKSTEP_CHECKSUMS=true

# Email Configuration (using Resend)
# Defaults when unset:
#   EMAIL_ENABLED: true
#   EMAIL_FROM: noreply@send.conquestk.com
#   EMAIL_FROM_NAME: ConquestK
EMAIL_ENABLED=true # default true
EMAIL_FROM=noreply@updates.conquestk.com  # Updates subdomain verified in Resend
EMAIL_FROM_NAME=ConquestK Game
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# Resend Configuration
RESEND_API_KEY=your-resend-api-key-here # required if EMAIL_ENABLED=true

# Note: SMTP is not used — transactional email is sent via Resend only.

# Web Push (optional; enables browser push notifications)
# Defaults when unset:
#   VAPID_EMAIL: mailto:admin@conquestk.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=mailto:admin@conquestk.com

# Notification Dispatching
# ENABLE_EXTERNAL_NOTIFICATIONS gates external webhooks (Slack/Discord). Web push is evaluated separately.
# NOTIFICATION_CHANNELS is a comma-separated allowlist. If set, only these channels will be attempted.
# Known: webpush, slack, discord
#   Examples:
#     NOTIFICATION_CHANNELS=webpush              # only web push
#     NOTIFICATION_CHANNELS=webpush,slack        # web push + Slack webhooks
ENABLE_EXTERNAL_NOTIFICATIONS=false # gates Slack/Discord webhooks
NOTIFICATION_CHANNELS=webpush,slack # allowlist; unset = all registered

# Slack Webhook Notifications
# SLACK_NOTIFICATIONS_ENABLED enables Slack dispatch (also requires ENABLE_EXTERNAL_NOTIFICATIONS=true).
# SLACK_WEBHOOK_URL accepts a single webhook; SLACK_WEBHOOK_URLS accepts a comma-separated list.
# SLACK_DEFAULT_CHANNEL is used when a payload doesn’t specify a channel.
# SLACK_ADDITIONAL_CHANNELS mirrors messages to extra channels (comma-separated).
# SLACK_USERNAME sets the bot display name; SLACK_ICON_EMOJI sets the bot avatar emoji.
SLACK_NOTIFICATIONS_ENABLED=false # requires ENABLE_EXTERNAL_NOTIFICATIONS=true
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX
SLACK_WEBHOOK_URLS=
SLACK_DEFAULT_CHANNEL=#operations
SLACK_ADDITIONAL_CHANNELS=#community,#devops
SLACK_USERNAME=ConquestK Alerts
SLACK_ICON_EMOJI=:crossed_swords:

# Slack App (Phase 2 prep — keep real values in .env.local only)
SLACK_APP_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_VERIFICATION_TOKEN=
# Populate once the app is installed and a bot token is issued:
# SLACK_BOT_TOKEN=xoxb-...

# Discord webhooks (Phase 1 foundations)
DISCORD_NOTIFICATIONS_ENABLED=false # requires ENABLE_EXTERNAL_NOTIFICATIONS=true
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456789012345678/XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DISCORD_WEBHOOK_URLS=
DISCORD_USERNAME=ConquestK Alerts
DISCORD_AVATAR_URL=
DISCORD_THREAD_ID=

# Public Asset URLs (recommended when using CDN or R2/S3)
# Used for generating absolute URLs in emails, CSP, and asset resolution.
PUBLIC_ASSET_BASE_URL=https://assets.conquestk.com # public CDN origin for assets
# The frontend also uses this base to resolve map/audio assets; backend seeds CDN health from it.
VITE_ASSET_BASE_URL=https://assets.conquestk.com # keep in sync with frontend Vite env

# Asset storage (Cloudflare R2 / S3-compatible). If omitted, uploads fall back to local /uploads.
# Provide all four to enable remote uploads. PUBLIC_ASSET_BASE_URL is recommended when remote is used.
# Defaults when unset:
#   ASSET_REGION: auto
# ASSET_BUCKET=conquestk
# ASSET_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# ASSET_ACCESS_KEY_ID=
# ASSET_SECRET_ACCESS_KEY=
# ASSET_REGION=auto
# Optional: override local directory for map staging uploads (dev/testing)
# MAP_UPLOADS_DIR=./map-uploads

# CDN configuration (optional)
# Purpose: read/distribution endpoints that serve already-built static content.
# This is separate from ASSET_* (upload/storage). You can run with just PUBLIC_ASSET_BASE_URL
# and no CDN_* vars; CDN_* lets the CDN service run provider-specific health/metrics and
# (optionally) uploads to a CDN-specific endpoint if supported.
# CDN_PRIMARY_URL=https://assets.conquestk.com
# CDN_API_KEY=
# CDN_REGIONAL_URLS=us=https://us.cdn.example.com,eu=https://eu.cdn.example.com
# CDN_GAME_ASSETS_URL=
# CDN_UPLOAD_ENDPOINT=

# Map staging cleanup (optional)
# Defaults when unset:
#   MAP_ASSET_PURGE_BATCH_SIZE: 100
#   MAP_ASSET_PURGE_MIN_AGE_MINUTES: 60
#   MAP_ASSET_PURGE_ALERT_THRESHOLD: 3
# MAP_ASSET_PURGE_BATCH_SIZE=100
# MAP_ASSET_PURGE_MIN_AGE_MINUTES=60
# MAP_ASSET_PURGE_ALERT_THRESHOLD=3

# Maintenance & data retention (optional overrides — sensible defaults are built-in)

NOTIFICATION_RETENTION_DAYS=60 # default 60 days
# If true, also prune unread notifications older than retention. Default: false
PRUNE_NOTIFICATIONS_INCLUDE_UNREAD=false # default false
# Interval for maintenance prune worker (ms). Default: daily (86_400_000).
# Uncomment to override cadence:
# MAINTENANCE_PRUNE_INTERVAL_MS=86400000
# GAME_MOVE_ARCHIVE_BATCH_SIZE=25 # Optional: archive batch size for completed game moves (default 25)

# Queues & BullMQ (optional)
# BULL_PREFIX=bull #Redis key prefix for all BullMQ queues (default: 'bull').
# QUEUE_READY_TIMEOUT_MS=15000 #how long to wait for queue readiness on startup.
# QUEUE_HEALTH_STRICT=true   # false treats "degraded" as healthy when Redis responds

# Worker scaling (optional)
# ENABLE_AUTO_SCALING: enable cluster worker auto-scaling based on runtime metrics (CPU/requests).
# MIN_WORKERS: minimum worker processes (default 2 when unset).
# MAX_WORKERS: maximum worker processes (default = number of CPU cores when unset).
# ENABLE_AUTO_SCALING=true
# MIN_WORKERS=2     # minimum worker processes
# MAX_WORKERS=4     # maximum worker processes (default = CPU cores)

# Match Service integration (optional)
# Defaults when unset:
#   USE_MATCHSVC: false
#   MATCHSVC_URL: http://localhost:8085
# USE_MATCHSVC=false
# MATCHSVC_URL=http://localhost:8085
# MATCHSVC_HMAC_SECRET=

# Metrics & Alerts (optional)
# Defaults when unset:
#   BATTLE_APPLY_FAILURE_ALERT_THRESHOLD: 3 (failures/min before loud alert)
# BATTLE_APPLY_FAILURE_ALERT_THRESHOLD=3

# Memory diagnostics (optional)
# Detects sustained heap growth and optionally captures heap snapshots for offline analysis.
# MEMORY_MONITOR_ENABLED=true                      # set to 'false' to disable
# MEMORY_MONITOR_SNAPSHOT_DIR=./health-reports/memory
# MEMORY_MONITOR_INTERVAL_MS=15000                 # sampling cadence (ms)
# MEMORY_MONITOR_GROWTH_THRESHOLD_MB=120           # growth threshold before alerting
# MEMORY_MONITOR_MIN_SAMPLES=8                     # minimum samples before trend evaluation
# MEMORY_MONITOR_ALERT_COOLDOWN_MS=600000          # minimum gap between alerts (ms)
# MEMORY_MONITOR_HISTORY_SIZE=24                   # samples retained in rolling window

# Startup toggles (optional)
# SYNC_FEATURE_FLAGS_ON_START: run feature-flag code scan on boot and sync to DB.
# RUN_DEPLOY_ACCOUNT_ENFORCEMENT_ON_START: ensure owner/test accounts exist and are correct.
# SKIP_DEPLOY_ACCOUNT_ENFORCEMENT: skip deploy account checks even if environment matches.
# ENFORCE_DEPLOY_ACCOUNT_CHECK: force deploy account checks regardless of environment.
# DEPLOY_ENV / APP_ENV: additional environment hinting (e.g., 'staging') used by some scripts.
# SKIP_DB_CONNECTION_TEST: skip initial SELECT 1 on pool startup.
# TEST_BASE_URL: base URL for internal perf/benchmark tooling.
# SYNC_FEATURE_FLAGS_ON_START=false
# RUN_DEPLOY_ACCOUNT_ENFORCEMENT_ON_START=false
# SKIP_DEPLOY_ACCOUNT_ENFORCEMENT=false
# ENFORCE_DEPLOY_ACCOUNT_CHECK=false
# DEPLOY_ENV=
# APP_ENV=
# SKIP_DB_CONNECTION_TEST=false
# TEST_BASE_URL=http://localhost:5001

# Session housekeeping (optional)
# Defaults when unset:
#   SESSION_MAX_AGE_HOURS: 168 (7 days)
#   SESSION_SWEEP_INTERVAL_MINUTES: 60
# SESSION_MAX_AGE_HOURS=168
# SESSION_SWEEP_INTERVAL_MINUTES=60

# Railway environment variables are injected by the platform (no need to set):
# RAILWAY_ENVIRONMENT, RAILWAY_ENVIRONMENT_NAME, RAILWAY_PROJECT_ID, RAILWAY_SERVICE_ID
