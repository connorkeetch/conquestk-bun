{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    "moduleDetection": "force",
    "noEmit": false,
    "outDir": "./dist-esm",
    "rootDir": "./src",
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@conquestk/shared/types": ["../shared/types/index.d.ts"],
      "@conquestk/shared/types/*": ["../shared/types/*.d.ts"],
      "@conquestk/shared/types/lockstep": ["src/types/modules/lockstep-proxy.d.ts"],
      "@conquestk/shared/*": ["../shared/dist/*"]
    }
  },
  "include": ["src/**/*", "src/types/**/*.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "dist-esm",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
