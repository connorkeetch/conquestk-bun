{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2020",
    "noEmit": false,
    "outDir": "./dist-esm",
    "rootDir": "./src",
    "baseUrl": "./",
    "paths": {
      "@conquestk/shared/*": ["../shared/*"],
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "dist-esm",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
