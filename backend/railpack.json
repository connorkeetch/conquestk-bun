{
  "$schema": "https://schema.railpack.com",
  "caches": {
    "npm-install": {
      "directory": "/root/.npm",
      "type": "shared"
    }
  },
  "steps": {
    "install": {
      "commands": [
        "npm ci"
      ],
      "caches": ["npm-install"]
    },
    "build": {
      "inputs": [
        { "step": "install" }
      ],
      "commands": [
        "npm run build",
        "npm prune --omit=dev"
      ],
      "caches": ["npm-install"]
    }
  },
  "deploy": {
    "startCommand": "npm start",
    "inputs": [
      {
        "step": "build",
        "include": [
          "package.json",
          "package-lock.json",
          ".nvmrc",
          "dist",
          "public",
          "node_modules",
          "migrations"
        ]
      }
    ]
  }
}
