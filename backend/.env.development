# Development Environment - PostgreSQL
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:5173

# Database Configuration
# Default to the local sandbox database because outbound TCP ports above 443 are blocked.
DATABASE_URL=postgresql://postgres:localpassword123@127.0.0.1:5432/risk_game_local
# To use the shared Railway database outside the sandbox, comment the line above and uncomment below.
# DATABASE_URL=postgresql://postgres:QZCDzahSSRUZLYUERywzrSMJvUWmgbor@yamanote.proxy.rlwy.net:46553/railway

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-for-development-only

# Redis Configuration (optional for local dev)
# REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=debug

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Web Push (VAPID)
# Use placeholder keys for local dev; real keys should be injected via deployment secrets.
VAPID_PUBLIC_KEY=your_dev_vapid_public_key
VAPID_PRIVATE_KEY=your_dev_vapid_private_key
VAPID_EMAIL=mailto:you@example.com

# Asset storage (Cloudflare R2)
# For local development, either leave these blank to fall back to /uploads,
# or provide non-sensitive placeholders. Do NOT commit real credentials.
ASSET_BUCKET=conquestk
ASSET_ENDPOINT=https://<your_r2_account>.r2.cloudflarestorage.com
ASSET_ACCESS_KEY_ID=your_r2_access_key_id
ASSET_SECRET_ACCESS_KEY=your_r2_secret_access_key
ASSET_REGION=auto
PUBLIC_ASSET_BASE_URL=https://assets.conquestk.com

# Maintenance & data retention (optional overrides — defaults work fine)
NOTIFICATION_RETENTION_DAYS=60
PRUNE_NOTIFICATIONS_INCLUDE_UNREAD=false
# Daily cadence
MAINTENANCE_PRUNE_INTERVAL_MS=86400000
