{
  "compilerOptions": {
    // Environment
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ESNext"],
    "types": ["node"],

    // Outputs / Layout (typecheck-only here)
    "outDir": "./dist",
    "rootDir": "../",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "noEmit": true,

    // Recommended strictness
    "strict": true,
    "isolatedModules": true,
    "moduleDetection": "force",

    // Compatibility & hygiene
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "removeComments": true,
    "noImplicitAny": true,
    "useUnknownInCatchVariables": false,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    // Paths
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@conquestk/shared/types": ["../shared/types/index.d.ts"],
      "@conquestk/shared/types/*": ["../shared/types/*.d.ts"],
      "@conquestk/shared/*": ["../shared/dist/*"]
    }
  },
  "include": ["src/**/*", "src/types/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
