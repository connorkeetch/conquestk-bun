{
  "name": "risk-game-backend",
  "version": "1.0.0",
  "description": "Backend server for Risk-like multiplayer board game",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc && tsc-alias",
    "typecheck": "tsc --noEmit",
    "postbuild": "node -e \"const fs=require('fs'); const path=require('path'); if (!fs.existsSync('dist/migrations')) { fs.mkdirSync('dist/migrations', {recursive:true}); } if (fs.existsSync('migrations')) { fs.cpSync('migrations', 'dist/migrations', {recursive:true}); console.log('\u2705 Copied migrations to dist/migrations'); } else { console.error('\u274c Warning: migrations directory not found'); }\"",
    "start": "node dist/scripts/runMigration.js && node dist/scripts/ensureDeployAccounts.js && node dist/index.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "seed:users": "ts-node src/scripts/seedUsers.ts",
    "seed": "npm run seed:users",
    "make-admin": "ts-node src/scripts/makeAdmin.ts",
    "diagnose-admin": "ts-node src/scripts/diagnoseAdminIssue.ts",
    "setup-production-admin": "ts-node src/scripts/setupProductionAdmin.ts",
    "validate-production": "ts-node src/scripts/validateAndFixProduction.ts",
    "migrate": "ts-node src/scripts/runMigration.ts",
    "test:email": "ts-node src/scripts/testEmail.ts",
    "check:schema": "ts-node src/scripts/checkSchema.ts",
    "migrate:status": "ts-node src/scripts/checkSchema.ts",
    "notify": "ts-node src/scripts/notify.ts",
    "backfill:conversation-read": "ts-node src/scripts/backfillConversationReadState.ts",
    "flags:check": "ts-node src/scripts/checkFeatureFlags.ts",
    "flags:sync": "ts-node src/scripts/checkFeatureFlags.ts --apply"
  },
  "dependencies": {
    "@risk-game/shared": "file:../shared",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^10.15.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@aws-sdk/client-s3": "^3.896.0",
    "@aws-sdk/lib-storage": "^3.896.0",
    "@types/bull": "^3.15.9",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.1",
    "@types/sharp": "^0.31.1",
    "@types/validator": "^13.15.3",
    "bad-words": "^4.0.0",
    "bcryptjs": "^3.0.2",
    "bull": "^4.16.5",
    "connect-redis": "^9.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "express-slow-down": "^3.0.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "image-size": "^2.0.2",
    "ioredis": "^5.8.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "open-graph-scraper": "^6.10.0",
    "multer": "^2.0.2",
    "node-fetch": "^2.7.0",
    "nodemailer": "^7.0.6",
    "pg": "^8.16.3",
    "rate-limit-redis": "^4.2.2",
    "resend": "^6.1.0",
    "sharp": "^0.34.4",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.3",
    "validator": "^13.15.15",
    "web-push": "^3.6.7",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-redis": "^0.0.23",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/express-slow-down": "^1.3.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "jest": "^30.1.3",
    "nodemon": "^3.1.10",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.2",
    "supertest": "^7.1.1"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  }
}
