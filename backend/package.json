{
  "name": "risk-game-backend",
  "version": "1.0.0",
  "description": "Backend server for Risk-like multiplayer board game",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "postbuild": "node -e \"const fs=require('fs'); const path=require('path'); if (!fs.existsSync('dist/migrations')) { fs.mkdirSync('dist/migrations', {recursive:true}); } fs.cpSync('migrations', 'dist/migrations', {recursive:true});\"",
    "start": "node dist/index.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "seed:users": "ts-node src/scripts/seedUsers.ts",
    "seed": "npm run seed:users",
    "make-admin": "ts-node src/scripts/makeAdmin.ts",
    "migrate": "ts-node src/scripts/runMigration.ts",
    "test:email": "ts-node src/scripts/testEmail.ts",
    "check:schema": "ts-node src/scripts/checkSchema.ts",
    "migrate:status": "ts-node src/scripts/checkSchema.ts"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.5",
    "@sentry/node": "^10.8.0",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.1",
    "@types/validator": "^13.15.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "express-rate-limit": "^6.11.2",
    "express-slow-down": "^1.6.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "image-size": "^2.0.2",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.5",
    "pg": "^8.16.3",
    "resend": "^6.0.2",
    "socket.io": "^4.7.5",
    "uuid": "^11.1.0",
    "validator": "^13.15.15",
    "web-push": "^3.6.7",
    "winston": "^3.13.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.23",
    "@types/express-slow-down": "^1.3.5",
    "@types/jest": "^30.0.0",
    "@types/joi": "^17.2.3",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "jest": "^30.0.5",
    "nodemon": "^3.1.4",
    "ts-jest": "^29.2.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
