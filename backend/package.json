{
  "name": "conquestk-backend",
  "version": "2.0.0",
  "description": "Backend server for Risk-like multiplayer board game (Colyseus + Bun)",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "prebuild": "cd ../shared && bun run build && cd ../shared/match-client && bun run build",
    "build": "bun build src/server.ts --outdir dist --target bun --external @conquestk/wasm-odds",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc -p tsconfig.strict.json --noEmit",
    "postbuild": "bun scripts/copy-migrations.cjs",
    "start": "bun run src/server.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "seed:users": "bun run src/scripts/seedUsers.ts",
    "seed": "bun run seed:users",
    "make-admin": "bun run src/scripts/makeAdmin.ts",
    "diagnose-admin": "bun run src/scripts/diagnoseAdminIssue.ts",
    "setup-production-admin": "bun run src/scripts/setupProductionAdmin.ts",
    "migrate": "bun run src/scripts/runMigration.ts",
    "test:email": "bun run src/scripts/testEmail.ts",
    "check:schema": "bun run src/scripts/checkSchema.ts",
    "migrate:status": "bun run src/scripts/checkSchema.ts",
    "migrate:squash": "bun run src/scripts/squashMigrations.ts",
    "notify": "bun run src/scripts/notify.ts",
    "backfill:conversation-read": "bun run src/scripts/backfillConversationReadState.ts",
    "flags:check": "bun run src/scripts/checkFeatureFlags.ts",
    "flags:sync": "bun run src/scripts/checkFeatureFlags.ts --apply",
    "purge:messages": "bun run src/scripts/purgeMessaging.ts",
    "purge:messages:yes": "bun run src/scripts/purgeMessaging.ts --yes",
    "wipe:games": "bun run src/scripts/wipeGames.ts",
    "wipe:games:yes": "bun run src/scripts/wipeGames.ts --yes",
    "wipe:redis": "bun run src/scripts/wipeRedisGames.ts",
    "wipe:redis:yes": "bun run src/scripts/wipeRedisGames.ts --yes",
    "purge:messages:include-blocks": "bun run src/scripts/purgeMessaging.ts --yes --include-user-blocks",
    "maps:import": "bun run src/scripts/importMapsPackage.ts",
    "maps:fix-image-urls": "bun run src/scripts/fixMapImageUrls.ts",
    "maps:rebuild-adj": "bun run src/scripts/rebuildAdjacencies.ts",
    "replay:match": "bun run src/scripts/replayMatch.ts",
    "replay:export": "bun run src/scripts/exportReplayFrames.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1064.0",
    "@aws-sdk/lib-storage": "^3.1064.0",
    "@colyseus/redis-driver": "^0.16.1",
    "@colyseus/redis-presence": "^0.16.4",
    "@colyseus/schema": "^3.0.76",
    "@colyseus/ws-transport": "^0.16.0",
    "@conquestk/match-client": "file:../shared/match-client",
    "@conquestk/shared": "file:../shared",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^10.56.0",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^7.0.11",
    "@types/sharp": "^0.31.1",
    "@types/validator": "^13.15.10",
    "adm-zip": "^0.5.17",
    "bad-words": "^4.0.0",
    "bcryptjs": "^3.0.3",
    "colyseus": "^0.16.5",
    "connect-redis": "^9.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "express-slow-down": "^3.1.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.2.0",
    "image-size": "^2.0.2",
    "ioredis": "^5.11.1",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^7.0.13",
    "open-graph-scraper": "^6.11.0",
    "pg": "^8.21.0",
    "rate-limit-redis": "^4.3.1",
    "resend": "^6.12.4",
    "sharp": "^0.34.5",
    "uuid": "^11.1.0",
    "validator": "^13.15.35",
    "web-push": "^3.6.7",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "^1.3.14",
    "@types/connect-redis": "^0.0.23",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.1",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "tsc-alias": "^1.8.17",
    "typescript": "^5.9.3"
  }
}
