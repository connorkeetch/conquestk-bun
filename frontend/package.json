{
  "name": "risk-game-frontend",
  "version": "1.0.0",
  "description": "React frontend for Risk-like multiplayer board game",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@reduxjs/toolkit": "^2.9.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/dompurify": "^3.0.5",
    "@types/uuid": "^10.0.0",
    "axios": "^1.11.0",
    "bad-words": "^4.0.0",
    "dompurify": "^3.2.7",
    "emoji-picker-react": "^4.13.3",
    "favico.js": "^0.3.10",
    "framer-motion": "12.23.22",
    "howler": "^2.2.4",
    "lucide-react": "0.544.0",
    "preline": "^3.2.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.63.0",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.9.2",
    "socket.io-client": "^4.8.1",
    "uuid": "^11.0.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "@vitest/ui": "3.2.4",
    "autoprefixer": "^10.4.21",
    "jsdom": "26.1.0",
    "postcss": "8.5.6",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22.11.0",
    "npm": ">=10.0.0"
  }
}
