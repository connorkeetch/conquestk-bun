########################################
# Frontend .env (Vite) — Dev vs Prod
# - Dev: you can set explicit http://localhost:5001 URLs for API and sockets.
# - Prod/Staging: LEAVE VITE_API_URL and VITE_SOCKET_URL UNSET so the app
#   uses relative '/api' and the current origin for sockets. Set the
#   VITE_ASSET_BASE_URL to your CDN in all environments.
########################################

# Backend API base URL
VITE_API_URL=http://localhost:5001/api # dev override; prod/staging leave UNSET to use '/api'

# Socket.io URL
VITE_SOCKET_URL=http://localhost:5001 # dev override; prod/staging leave UNSET to use current origin

# Public asset base URL (RECOMMENDED in all environments)
VITE_ASSET_BASE_URL= # required for CDN assets; prod/staging set to CDN origin (e.g. https://assets.conquestk.com)

# Web push public key
# VITE_VAPID_PUBLIC_KEY= # dev optional; prod/staging set if enabling browser push

# Canonical host hints (PRODUCTION ONLY)
# VITE_CANONICAL_HOST=conquestk.com # enforce apex host redirect in production
# VITE_CANONICAL_REDIRECT_HOSTS=www.conquestk.com # comma-separated aliases to redirect
