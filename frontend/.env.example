# Optional: override defaults used in development
# In production the app uses relative '/api' and the current origin for sockets.
# In development, if unset, the app falls back to http://localhost:5001.

# Backend API base URL (leave unset to auto-detect)
VITE_API_URL=http://localhost:5001/api

# Socket.io URL (leave unset to auto-detect)
VITE_SOCKET_URL=http://localhost:5001

# Public asset base URL (required to resolve map/audio assets from CDN)
# For local dev, you can leave this empty or point to your CDN.
VITE_ASSET_BASE_URL=

# Optional: web push public key (if testing push locally)
# VITE_VAPID_PUBLIC_KEY=
