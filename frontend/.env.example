########################################
# Frontend .env (Vite) — Dev vs Prod
# - Dev: you can set explicit http://localhost:5001 URLs for API and sockets.
# - Prod/Staging: LEAVE VITE_API_URL and VITE_SOCKET_URL UNSET so the app
#   uses relative '/api' and the current origin for sockets. Set the
#   VITE_ASSET_BASE_URL to your CDN in all environments.
########################################

# Backend API base URL
# Dev: set to http://localhost:5001/api if you want to override
#      auto-detection (otherwise leave unset).
# Prod/Staging: leave UNSET to use relative '/api'.
VITE_API_URL=http://localhost:5001/api

# Socket.io URL
# Dev: set to http://localhost:5001 if needed; otherwise leave unset.
# Prod/Staging: leave UNSET to use the current origin.
VITE_SOCKET_URL=http://localhost:5001

# Public asset base URL (RECOMMENDED in all environments)
# Required to load CDN-hosted map/audio assets (the repo no longer ships these).
# Dev: point to your CDN origin (e.g. https://assets.conquestk.com). If left
#      empty, the app will attempt relative paths which will not load CDN media.
# Prod/Staging: set to your CDN origin.
VITE_ASSET_BASE_URL=

# Web push public key
# Dev: optional (only if you’re testing push locally).
# Prod/Staging: set if enabling browser push notifications.
# VITE_VAPID_PUBLIC_KEY=

# Canonical host hints (PRODUCTION ONLY)
# If set, the app will redirect www/apex aliases to this host to avoid split state.
# VITE_CANONICAL_HOST=conquestk.com
# Comma-separated additional hosts to treat as aliases (will redirect to canonical).
# VITE_CANONICAL_REDIRECT_HOSTS=www.conquestk.com
