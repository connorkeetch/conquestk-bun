{
  "name": "@conquestk/wasm-odds",
  "version": "0.1.0",
  "description": "Risk combat odds in Rust → WebAssembly for Node and browser",
  "type": "module",
  "private": true,
  "scripts": {
    "build:ts": "tsc -p tsconfig.json",
    "wasm:build": "wasm-pack build --release --target bundler --out-dir pkg crate",
    "wasm:build:dev": "wasm-pack build --dev --target bundler --out-dir pkg crate",
    "test:rs": "cd crate && cargo test",
    "bench:rs": "cd crate && cargo bench",
    "test:ts": "vitest run -w 1",
    "build": "npm run build:ts && npm run wasm:build"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^2.1.3"
  },
  "keywords": [
    "risk",
    "wasm",
    "odds",
    "monte-carlo",
    "rust",
    "xoshiro"
  ]
}
