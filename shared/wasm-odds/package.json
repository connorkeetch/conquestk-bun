{
  "name": "@conquestk/wasm-odds",
  "version": "0.1.0",
  "description": "Risk combat odds in Rust → WebAssembly for Node and browser",
  "type": "module",
  "private": true,
  "scripts": {
    "wasm:build": "wasm-pack build --release --target bundler --out-dir ../pkg crate && wasm-pack build --release --target nodejs --out-dir ../pkg-node crate",
    "build:ts": "tsc -p tsconfig.json",
    "wasm:build:dev": "wasm-pack build --dev --target bundler --out-dir pkg crate",
    "test:rs": "cd crate && cargo test",
    "bench:rs": "cd crate && cargo bench",
    "test:ts": "vitest run",
    "build": "npm run wasm:build && npm run build:ts"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "3.2.4"
  },
  "keywords": [
    "risk",
    "wasm",
    "odds",
    "monte-carlo",
    "rust",
    "xoshiro"
  ]
}
