{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "node",
    "moduleDetection": "force"
  },
  "include": ["types/**/*.ts", "constants/**/*.ts", "utils/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
